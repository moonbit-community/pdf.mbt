name = "illusory0x0/pdf"

version = "0.1.0"

import {
  "moonbitlang/x@0.4.49",
  "moonbit-community/cmark@0.4.3",
  "moonbitlang/lexer@0.3.13",
}

readme = "README.md"

repository = "https://github.com/illusory0x0/pdf_writer.mbt"

license = "Apache-2.0"

keywords = [ ]

description = "A MoonBit library for generating standards-compliant PDF documents with comprehensive support for PDF objects, graphics operators."

options(
  exclude: [ "resources/pdf_dataset" ],
)
