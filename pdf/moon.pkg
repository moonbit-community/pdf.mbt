import {
  "illusory0x0/pdf/fmt",
  "illusory0x0/pdf/lexer_bytes",
  "moonbitlang/core/buffer",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/core/json",
  "moonbitlang/core/list",
}

import {
  "moonbitlang/x/fs",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/core/test",
} for "test"

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.19 --external-tokens $input -o $output",
)

dev_build(
  rule: "moonyacc",
  input: "pdf_obj_parser.mbty",
  output: "pdf_obj_parser.mbt",
)
